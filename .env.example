PORT=3001
NODE_ENV=development
# Production URL values on Render:
# PRODUCT_BASE_URL=https://automate.afrointelligent.co.za
# API_BASE_URL=https://automate.afrointelligent.co.za
# FRONTEND_URL=https://automate.afrointelligent.co.za
# PUBLIC_API_URL=https://automate.afrointelligent.co.za
# Local development values:
PRODUCT_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
WHATSAPP_VERIFY_TOKEN=your-own-random-verify-token
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_RECIPIENT_PHONE=27XXXXXXXXX
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
DEEPSEEK_API_KEY=
MONGODB_URI=
MONGO_DB_NAME=afrointelligent
# For legacy deployments only. Prefer MONGODB_URI.
DATABASE_URL=
FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
LOCAL_FRONTEND_PROXY_ENABLED=false
# Required in production to access internal dashboard/demo endpoints.
INTERNAL_API_KEY=
PAYMENT_PROVIDER=DEMO
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password

# Transactional email (password resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AfroIntelligent <no-reply@example.com>"
